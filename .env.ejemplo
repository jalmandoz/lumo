# Copia este archivo como .env y pega tus claves.
# El archivo .env no entra en git, tus claves no salen de tu maquina.

# Google PageSpeed. Gratis, sin tarjeta.
# Se saca en https://developers.google.com/speed/docs/insights/v5/get-started
CLAVE_GOOGLE=

# Anthropic. Se paga por uso.
# Se saca en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
